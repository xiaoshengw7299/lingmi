APP_PORT=8090
APP_PREFIX=api
PUBLIC_BASE_URL=http://127.0.0.1:8090

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=a123456
DB_DATABASE=nimblepay

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0

# 32 字节 hex，64 个字符。用来加密支付宝私钥
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d
ADMIN_BOOTSTRAP_PASSWORD=123456

# nimble-ai 调用开放接口的 HMAC。两边必须一致
NIMBLE_APP_ID=nimble-web
NIMBLE_APP_SECRET=nimblepay-local-hmac-secret-v1
# 开放接口每分钟总限额。文本模型会产生大量小额扣款，默认 3000
# OPEN_RATE_LIMIT_PER_MIN=3000
CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
NODE_ENV=development
